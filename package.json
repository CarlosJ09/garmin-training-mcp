{
  "name": "garmin-training-mcp",
  "version": "0.2.0",
  "private": true,
  "description": "Local MCP server that answers questions about your Garmin running and strength training.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "node src/stdio.ts",
    "demo": "node src/stdio.ts --demo",
    "preview": "node src/preview.ts",
    "preview:demo": "node src/preview.ts --demo",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
